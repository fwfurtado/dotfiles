input {
    keyboard {
        xkb {
            layout "us"
            variant "mac"
            model "pc105"
            options "lv3:ralt_switch"
        }

        repeat-rate 40
        repeat-delay 300
    }

    mouse {
        accel-speed 0.6
        accel-profile "adaptive"
    }

    touchpad {
        tap
        natural-scroll
        dwt
        click-method "clickfinger"
    }
}

// Para o primeiro login, deixaria o Niri escolher automaticamente
// resolução e refresh.
//
// Depois de entrar:
//   niri msg outputs
//
// e então podemos fixar exatamente seu 5120x1440@120.xxx.
output "DP-1" {
    mode "5120x1440@119.999"
    scale 1
}

output "HDMI-A-1" {
    mode "5120x1440@59.977"
    scale 1
}

layout {
    gaps 10

    // É o comportamento mais próximo do scrolling que você está usando.
    center-focused-column "always"

    default-column-width {
        proportion 0.5
    }
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

binds {
    // Hotkey overlay
    Mod+Shift+Slash {
        spawn "noctalia" "msg" "panel-toggle" "kenn/keybind-cheatsheet:cheatsheet"
    }

    // Apps
    Mod+Return {
        spawn "ghostty" "+new-window"
    }

    Mod+Shift+Return {
        spawn "google-chrome"
    }

    Mod+Space {
        spawn "noctalia" "msg" "panel-toggle" "launcher"
    }

    // Overview nativo
    Mod+O repeat=false {
        toggle-overview
    }

    // Window / column navigation.
    Mod+Left {
        focus-column-left
    }

    Mod+Right {
        focus-column-right
    }

    Mod+Up {
        focus-window-up
    }

    Mod+Down {
        focus-window-down
    }

    // Mover dentro do layout.
    Mod+Ctrl+Left {
        move-column-left
    }

    Mod+Ctrl+Right {
        move-column-right
    }

    Mod+Ctrl+Up {
        move-window-up
    }

    Mod+Ctrl+Down {
        move-window-down
    }

    // Mover float window
    Mod+Alt+Left  { move-floating-window x=-100; }
    Mod+Alt+Right { move-floating-window x=+100; }
    Mod+Alt+Up    { move-floating-window y=-100; }
    Mod+Alt+Down  { move-floating-window y=+100; }

    // Workspaces dinâmicos verticais.
    Mod+Page_Up {
        focus-workspace-up
    }

    Mod+Page_Down {
        focus-workspace-down
    }

    Mod+Ctrl+Page_Up {
        move-column-to-workspace-up
    }

    Mod+Ctrl+Page_Down {
        move-column-to-workspace-down
    }

    // Column operations.
    Mod+C {
        center-column
    }

    Mod+BracketLeft {
        consume-or-expel-window-left
    }

    Mod+BracketRight {
        consume-or-expel-window-right
    }

    Mod+R {
        switch-preset-column-width
    }

    Mod+Shift+R {
        switch-preset-column-width-back
    }

    // Window state.
    Mod+Q repeat=false {
        close-window
    }

    Mod+M {
        maximize-column
    }

    Mod+Shift+M {
        fullscreen-window
    }

    Mod+F {
        toggle-window-floating
    }

    Mod+Shift+F {
        switch-focus-between-floating-and-tilling;
    }

    // Clipboard
    Mod+V {
        spawn "noctalia" "msg" "panel-toggle" "clipboard";
    }

    // Lock.
    Mod+Alt+L {
        spawn "noctalia" "msg" "session" "lock";
    }

    // Volume / audio
    XF86AudioRaiseVolume {
        spawn "noctalia" "msg" "volume-up";
    }

    XF86AudioLowerVolume {
        spawn "noctalia" "msg" "volume-down";
    }

    XF86AudioMute repeat=false allow-when-locked=true {
        spawn "noctalia" "msg" "volume-mute";
    }

    XF86AudioMicMute repeat=false allow-when-locked=true {
        spawn "noctalia" "msg" "mic-mute";
    }

    // Media
    XF86AudioPlay repeat=false allow-when-locked=true {
        spawn "noctalia" "msg" "media" "toggle";
    }

    XF86AudioNext repeat=false allow-when-locked=true {
        spawn "noctalia" "msg" "media" "next";
    }

    XF86AudioPrev repeat=false allow-when-locked=true {
        spawn "noctalia" "msg" "media" "previous";
    }

    // Brightness
    XF86MonBrightnessUp {
        spawn "noctalia" "msg" "brightness-up";
    }

    XF86MonBrightnessDown {
        spawn "noctalia" "msg" "brightness-down";
    }

    // Screenshot
    Print {
        spawn "noctalia" "msg" "screenshot-region";
    }
}

include "noctalia.kdl"
