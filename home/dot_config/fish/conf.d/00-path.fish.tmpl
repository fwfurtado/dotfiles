# ~/.config/fish/conf.d/00-path.fish.tmpl  (chezmoi)
{{ if eq .chezmoi.os "darwin" -}}
if test -x /opt/homebrew/bin/brew
    /opt/homebrew/bin/brew shellenv fish | source
end
fish_add_path -g /pkg/env/global/bin
{{ end -}}

fish_add_path -g $HOME/.local/bin $HOME/.cargo/bin $HOME/go/bin $HOME/.krew/bin

{{ range $m.extraPaths }}
fish_add_path -g {{ . }}
{{- end }}
