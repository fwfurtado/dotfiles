#!/usr/bin/env bash
# Verifica as partes que quebram silenciosamente.
# Rode isto ANTES da primeira call, não durante.
set -uo pipefail

pass() { printf '\033[1;32m  ok  \033[0m %s\n' "$*"; }
fail() { printf '\033[1;31m FAIL \033[0m %s\n' "$*"; FAILED=1; }
warn() { printf '\033[1;33m warn \033[0m %s\n' "$*"; }
head() { printf '\n\033[1;36m%s\033[0m\n' "$*"; }

FAILED=0

head "Sessão"
[[ "${XDG_CURRENT_DESKTOP:-}" == "Hyprland" ]] \
    && pass "XDG_CURRENT_DESKTOP=Hyprland" \
    || fail "XDG_CURRENT_DESKTOP='${XDG_CURRENT_DESKTOP:-vazio}' — screen share vai falhar"
[[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] \
    && pass "instância Hyprland ativa" \
    || fail "HYPRLAND_INSTANCE_SIGNATURE ausente"
[[ "${XDG_SESSION_TYPE:-}" == "wayland" ]] \
    && pass "sessão wayland" \
    || fail "XDG_SESSION_TYPE='${XDG_SESSION_TYPE:-vazio}'"

head "Monitor"
if command -v jq >/dev/null; then
    hyprctl -j monitors | jq -r '.[] |
        "  \(.name)  \(.width)x\(.height)@\(.refreshRate | . * 100 | round / 100)Hz  scale \(.scale)  vrr \(.vrr)"'
    real=$(hyprctl -j monitors | jq -r '.[0].refreshRate')
    if (( $(echo "$real < 100" | bc -l) )); then
        fail "refresh em ${real}Hz — quase certo que o modo em monitors.conf não existe. Rode: hyprctl monitors all"
    else
        pass "refresh acima de 100Hz"
    fi
else
    warn "jq não instalado"
fi

head "Portais (screen share)"
for svc in xdg-desktop-portal xdg-desktop-portal-hyprland; do
    if systemctl --user is-active --quiet "$svc"; then
        pass "$svc ativo"
    else
        fail "$svc parado — 'systemctl --user restart $svc'"
    fi
done
if [[ -f "$HOME/.config/xdg-desktop-portal/hyprland-portals.conf" ]]; then
    pass "hyprland-portals.conf presente"
else
    fail "hyprland-portals.conf ausente — o backend do GNOME vai ser escolhido"
fi
if systemctl --user is-active --quiet xdg-desktop-portal-gnome 2>/dev/null; then
    warn "portal do GNOME rodando em paralelo (esperado se você alternou de sessão sem relogar)"
fi

head "Áudio"
if systemctl --user is-active --quiet pipewire wireplumber; then
    pass "pipewire + wireplumber"
    wpctl status 2>/dev/null | sed -n '/Sinks:/,/^$/p' | command head -6
else
    fail "pipewire ou wireplumber parado"
fi

head "Bluetooth"
systemctl is-active --quiet bluetooth \
    && pass "bluetoothd ativo" \
    || fail "bluetoothd parado"
if ! dpkg -l libspa-0.2-bluetooth 2>/dev/null | grep -q '^ii'; then
    fail "libspa-0.2-bluetooth ausente — fone conecta mas não sai áudio"
else
    pass "codecs bluetooth do pipewire instalados"
fi

head "Shell"
for service in bar cheatsheet controlcenter dashboard omni; do
    unit="quickshell@${service}.service"
    if systemctl --user is-active --quiet "$unit"; then
        pass "$unit ativo"
    else
        fail "$unit parado — 'systemctl --user restart $unit'"
    fi
done

head "Chaveiro (VS Code, docker login, git credential)"
pgrep -f gnome-keyring-daemon >/dev/null \
    && pass "gnome-keyring ativo" \
    || warn "gnome-keyring parado — VS Code vai pedir senha toda hora"

head "Docker"
if command -v docker >/dev/null; then
    docker info >/dev/null 2>&1 \
        && pass "daemon acessível sem sudo" \
        || warn "docker info falhou (grupo 'docker'? daemon parado?)"
else
    warn "docker não instalado"
fi

echo
if (( FAILED )); then
    printf '\033[1;31mHá falhas acima. Resolva antes de depender disto numa call.\033[0m\n'
    exit 1
fi
printf '\033[1;32mTudo verde.\033[0m\n'
