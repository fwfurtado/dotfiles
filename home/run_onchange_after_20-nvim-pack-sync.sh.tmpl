#!/usr/bin/env bash
# Roda quando o lockfile muda — inclusive quando um chezmoi update traz
# revisões novas de outra máquina.
#
# lockfile: {{ include "dot_config/exact_nvim/nvim-pack-lock.json" | sha256sum }}

set -euo pipefail

command -v nvim >/dev/null 2>&1 || exit 0

nvim --headless -c 'lua vim.pack.update(nil, { target = "lockfile" })' -c 'quitall'
