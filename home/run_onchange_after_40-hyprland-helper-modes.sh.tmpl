#!/usr/bin/env bash
# Reapply executable modes to managed Hyprland helper files.
# hyprland-lua-session:    {{ include "dot_local/bin/hyprland-lua-session" | sha256sum }}
# hyprland-legacy-session: {{ include "dot_local/bin/hyprland-legacy-session" | sha256sum }}
# hypr-cinema:        {{ include "dot_local/bin/hypr-cinema" | sha256sum }}
# hypr-doctor:        {{ include "dot_local/bin/hypr-doctor" | sha256sum }}
# hypr-sharebar:      {{ include "dot_local/bin/hypr-sharebar" | sha256sum }}
# move-workspace.sh:  {{ include "dot_config/hypr/scripts/move-workspace.sh" | sha256sum }}

set -euo pipefail

for file in \
    "$HOME/.local/bin/hyprland-lua-session" \
    "$HOME/.local/bin/hyprland-legacy-session" \
    "$HOME/.local/bin/hypr-cinema" \
    "$HOME/.local/bin/hypr-doctor" \
    "$HOME/.local/bin/hypr-sharebar" \
    "$HOME/.config/hypr/scripts/move-workspace.sh"; do
    if [[ -f "$file" ]]; then
        chmod 0755 -- "$file"
    fi
done
